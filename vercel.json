{
  "version": 2,
  "builds": [
    {
      "src": "api/bot.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/bg.png",
      "dest": "api/bot.ts"
    },
    {
      "src": "/api/bot",
      "dest": "api/bot.ts"
    },
    {
      "src": "/(.*)",
      "dest": "api/bot.ts"
    }
  ]
}
